#&'strict'
#&'verbosity'
#&'debug'
#&'us-config'
#&'us-host'
#&'log'

PATH+=:${U_S}/tool/sh/part
PATH+=:${U_S}/src/bash/lib
PATH+=:${U_S}/src/sh/lib
export PATH
  
#&'us-basedir'
#&'us-package'

$LOG info :$0 "Ready"

. <(line_prefix "export " < .env)

#:modeline Id: env.bash.build   vim:set ft=bash sw=2 sts=2 et:
